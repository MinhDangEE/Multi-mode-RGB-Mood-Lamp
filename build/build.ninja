#############################################
# Utility command for edit_cache

build cmake/stm32cubemx/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D "D:\FINAL_PROJECT (1)\build\cmake\stm32cubemx" && "C:\Program Files\CMake\bin\cmake-gui.exe" -S"D:\FINAL_PROJECT (1)" -B"D:\FINAL_PROJECT (1)\build""
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build cmake/stm32cubemx/edit_cache: phony cmake/stm32cubemx/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build cmake/stm32cubemx/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D "D:\FINAL_PROJECT (1)\build\cmake\stm32cubemx" && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -S"D:\FINAL_PROJECT (1)" -B"D:\FINAL_PROJECT (1)\build""
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build cmake/stm32cubemx/rebuild_cache: phony cmake/stm32cubemx/CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build STM32: phony STM32.elf

build STM32_Drivers: phony cmake/stm32cubemx/STM32_Drivers

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: D:/FINAL_PROJECT (1)/build

build all: phony STM32.elf cmake/stm32cubemx/all

# =============================================================================

#############################################
# Folder: D:/FINAL_PROJECT (1)/build/cmake/stm32cubemx

build cmake/stm32cubemx/all: phony cmake/stm32cubemx/STM32_Drivers

# =============================================================================
